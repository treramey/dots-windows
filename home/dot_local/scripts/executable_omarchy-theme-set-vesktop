#!/bin/bash
set -euo pipefail

# Sync Vesktop's generated Omarchy system theme from the active Omarchy palette.
# Mirrors Omarchy/Ryan's generated-theme approach used for Pi: one stable theme
# file whose colors are regenerated whenever the Omarchy theme changes.

CURRENT_THEME_PATH="$HOME/.local/state/omarchy/current/theme"
COLORS_PATH="$CURRENT_THEME_PATH/colors.toml"
VESKTOP_CONFIG_DIR="${XDG_CONFIG_HOME:-$HOME/.config}/vesktop"
VESKTOP_THEMES_DIR="$VESKTOP_CONFIG_DIR/themes"
VESKTOP_THEME_NAME="omarchy-system.css"
VESKTOP_THEME_PATH="$VESKTOP_THEMES_DIR/$VESKTOP_THEME_NAME"
VESKTOP_SETTINGS_PATH="$VESKTOP_CONFIG_DIR/settings/settings.json"
ACTIVATE=0

usage() {
  echo "Usage: omarchy-theme-set-vesktop [--activate]"
}

for arg in "$@"; do
  case "$arg" in
    --activate)
      ACTIVATE=1
      ;;
    -h | --help)
      usage
      exit 0
      ;;
    *)
      usage >&2
      exit 1
      ;;
  esac
done

if [[ ! -f $COLORS_PATH ]]; then
  if (( ACTIVATE == 1 )); then
    echo "Vesktop theme source missing: $COLORS_PATH" >&2
    exit 1
  fi

  exit 0
fi

if (( ACTIVATE == 0 )) && [[ ! -d $VESKTOP_CONFIG_DIR ]]; then
  exit 0
fi

mkdir -p "$VESKTOP_THEMES_DIR"

/usr/bin/python3 - "$COLORS_PATH" "$VESKTOP_THEME_PATH" <<'PY'
import os
import subprocess
import sys
import tempfile

colors_path, theme_path = sys.argv[1], sys.argv[2]

resolved_colors = subprocess.run(
    ["omarchy-theme-color", "--file", colors_path, "--all"],
    check=True,
    capture_output=True,
    text=True,
).stdout.splitlines()
source = dict(line.split("\t", 1) for line in resolved_colors if "\t" in line)


def hex_to_rgb(value):
    value = value.strip().lstrip("#")
    if len(value) != 6:
        raise ValueError(f"Expected 6-digit hex color, got {value!r}")
    return tuple(int(value[i : i + 2], 16) for i in (0, 2, 4))


def rgb_to_hex(rgb):
    return "#%02x%02x%02x" % tuple(max(0, min(255, int(round(channel)))) for channel in rgb)


def mix(start, end, amount):
    start_rgb = hex_to_rgb(start)
    end_rgb = hex_to_rgb(end)
    return rgb_to_hex(tuple(start_rgb[i] * (1 - amount) + end_rgb[i] * amount for i in range(3)))


def rgb_triplet(hex_color):
    return ", ".join(str(channel) for channel in hex_to_rgb(hex_color))


def relative_luminance(hex_color):
    def channel(value):
        srgb = value / 255
        return srgb / 12.92 if srgb <= 0.04045 else ((srgb + 0.055) / 1.055) ** 2.4

    red, green, blue = hex_to_rgb(hex_color)
    return 0.2126 * channel(red) + 0.7152 * channel(green) + 0.0722 * channel(blue)


required = [
    "background",
    "foreground",
    "accent",
    "selection_background",
    "selection_foreground",
    *[f"color{i}" for i in range(16)],
]
missing = [key for key in required if key not in source]
if missing:
    raise SystemExit(f"Missing required Omarchy colors: {', '.join(missing)}")

background = source["background"]
foreground = source["foreground"]
accent = source["accent"]

# Ryan/Omarchy da53c0f-style derived surfaces, with stronger light-theme
# contrast for Discord's large flat surfaces and placeholder text.
is_dark = relative_luminance(background) < 0.5
panel = mix(background, foreground, 0.06 if is_dark else 0.12)
panel_alt = mix(background, foreground, 0.10 if is_dark else 0.18)
panel_pending = mix(background, accent, 0.12 if is_dark else 0.16)
panel_success = mix(background, source["color2"], 0.12 if is_dark else 0.16)
panel_error = mix(background, source["color1"], 0.12 if is_dark else 0.16)
border = mix(background, foreground, 0.30 if is_dark else 0.38)
border_muted = mix(background, foreground, 0.20 if is_dark else 0.28)
muted_text = mix(foreground, background, 0.34 if is_dark else 0.18)
dim_text = mix(foreground, background, 0.52 if is_dark else 0.34)
selected_background = mix(background, accent, 0.22 if is_dark else 0.28)
hover_background = mix(background, foreground, 0.14 if is_dark else 0.20)
active_background = mix(background, accent, 0.18 if is_dark else 0.24)
input_background = mix(background, foreground, 0.08 if is_dark else 0.14)

css = f"""/**
 * @name Omarchy System
 * @author generated by omarchy-theme-set-vesktop
 * @description Generated from the active Omarchy palette. Do not edit directly.
 */

:root,
.theme-dark,
.theme-light {{
  --omarchy-background: {background};
  --omarchy-foreground: {foreground};
  --omarchy-accent: {accent};
  --omarchy-panel: {panel};
  --omarchy-panel-alt: {panel_alt};
  --omarchy-border: {border};
  --omarchy-border-muted: {border_muted};
  --omarchy-muted-text: {muted_text};
  --omarchy-dim-text: {dim_text};

  --background-primary: {background};
  --background-secondary: {background};
  --background-secondary-alt: {panel_alt};
  --background-tertiary: {background};
  --background-accent: {accent};
  --background-floating: {panel};
  --background-nested-floating: {panel_alt};
  --background-mobile-primary: {background};
  --background-mobile-secondary: {panel};

  --bg-base-primary: {background};
  --bg-base-secondary: {background};
  --bg-base-tertiary: {background};
  --bg-surface-overlay: {panel};
  --bg-surface-raised: {panel};
  --bg-surface-high: {panel_alt};
  --bg-mod-faint: {panel};
  --bg-mod-subtle: {hover_background};
  --bg-mod-strong: {active_background};
  --bg-brand: {accent};

  --background-base-lowest: {background};
  --background-base-lower: {background};
  --background-base-low: {background};
  --background-surface-highest: {panel_alt};
  --background-surface-higher: {panel};
  --background-surface-high: {panel};
  --background-code: {panel};
  --border-faint: {border_muted};
  --border-subtle: {border_muted};
  --border-normal: {border};
  --border-strong: {border};

  --text-normal: {foreground};
  --text-muted: {muted_text};
  --text-link: {accent};
  --text-positive: {source['color2']};
  --text-warning: {source['color3']};
  --text-danger: {source['color1']};
  --header-primary: {foreground};
  --header-secondary: {muted_text};
  --channels-default: {muted_text};
  --channel-icon: {dim_text};
  --channel-text-area-placeholder: {dim_text};

  --interactive-normal: {muted_text};
  --interactive-hover: {foreground};
  --interactive-active: {foreground};
  --interactive-muted: {dim_text};

  --brand-360: {accent};
  --brand-400: {accent};
  --brand-500: {accent};
  --brand-560: {accent};
  --brand-600: {accent};
  --brand-experiment: {accent};
  --brand-experiment-560: {accent};
  --control-brand-foreground: {accent};
  --mention-foreground: {accent};
  --mention-background: {panel_pending};

  --background-modifier-hover: {hover_background};
  --background-modifier-active: {active_background};
  --background-modifier-selected: {selected_background};
  --background-modifier-accent: {border_muted};

  --input-background: {input_background};
  --channeltextarea-background: {input_background};
  --modal-background: {background};
  --modal-footer-background: {panel};
  --card-primary-bg: {panel};
  --card-secondary-bg: {panel_alt};
  --chat-background: {background};
  --chat-border: {border_muted};
  --chat-input-container-background: {panel};
  --background-message-hover: {hover_background};
  --background-mentioned: {panel_pending};
  --background-mentioned-hover: {active_background};
  --home-background: {background};
  --app-background-frame: {background};
  --app-background: {background};

  --scrollbar-thin-thumb: {border};
  --scrollbar-thin-track: transparent;
  --scrollbar-auto-thumb: {border};
  --scrollbar-auto-track: {panel};
  --scrollbar-auto-scrollbar-color-thumb: {border};
  --scrollbar-auto-scrollbar-color-track: {panel};

  --status-positive: {source['color2']};
  --status-positive-background: {panel_success};
  --status-warning: {source['color3']};
  --status-danger: {source['color1']};
  --status-danger-background: {panel_error};
  --status-speaking: {source['color2']};

  --button-positive-background: {source['color2']};
  --button-danger-background: {source['color1']};
  --button-secondary-background: {panel_alt};
  --button-secondary-background-hover: {hover_background};

  --selection-background: {source['selection_background']};
  --selection-foreground: {source['selection_foreground']};
  --focus-primary: {accent};

  --white-500: {source['color7']};
  --black-500: {source['color0']};
  --red-400: {source['color1']};
  --green-360: {source['color2']};
  --yellow-300: {source['color3']};
  --blue-345: {source['color4']};
  --purple-360: {source['color5']};
  --cyan-400: {source['color6']};

  --custom-theme-background: {background};
  --custom-channel-members-bg: {panel};
}}

::selection {{
  color: {source['selection_foreground']};
  background: {source['selection_background']};
}}

/* Paint the major app regions explicitly. Vesktop transparency can otherwise
 * let wallpaper/underlay colors bleed through unpainted Discord surfaces. */
body,
#app-mount,
[class*="app_"],
[class*="bg_"],
[class*="chat_"],
[class*="chatContent_"],
[class*="container_"][class*="chat"],
[class*="peopleColumn_"],
[class*="peopleList_"],
[class*="tabBody_"],
[class*="standardSidebarView_"],
[class*="contentRegion_"],
[class*="membersWrap_"] {{
  background: {background} !important;
  background-color: {background} !important;
}}

/* Keep navigation continuous with its header instead of using the raised
 * panel color. Nested scrollers stay transparent and inherit this surface. */
[class*="guilds_"],
[class*="sidebar_"],
[class*="privateChannels_"],
[class*="container_"][class*="sidebar"] {{
  background: {background} !important;
  background-color: {background} !important;
}}

[class*="panels_"],
[class*="nowPlayingColumn_"] {{
  background: {panel} !important;
  background-color: {panel} !important;
}}

[class*="itemCard_"],
[class*="section_"],
[class*="peopleListItem_"],
[class*="member_"],
[class*="interactive_"]:hover {{
  background-color: {hover_background} !important;
}}

/* Separate friend cards with the page background. This leaves a clean gap
 * between cards while the divider above the first card disappears into the page. */
[class*="peopleList_"] [class*="divider_"] {{
  background-color: {background} !important;
  border-color: {background} !important;
}}

[class*="channelTextArea_"],
[class*="scrollableContainer_"],
[class*="inner_"][class*="sansAttachButton_"],
[class*="searchBar_"] {{
  background: {input_background} !important;
  background-color: {input_background} !important;
}}

/* Smooth out a few places that still use hard-coded overlays. */
[class*="chatContent_"],
[class*="panels_"],
[class*="sidebar_"],
[class*="membersWrap_"] {{
  border-color: {border_muted};
}}

/* RGB triplets for themes/plugins that consume them. */
:root {{
  --omarchy-accent-rgb: {rgb_triplet(accent)};
  --omarchy-background-rgb: {rgb_triplet(background)};
  --omarchy-foreground-rgb: {rgb_triplet(foreground)};
}}
"""

os.makedirs(os.path.dirname(theme_path), exist_ok=True)
fd, tmp_path = tempfile.mkstemp(prefix=".omarchy-system.", suffix=".css", dir=os.path.dirname(theme_path))
try:
    with os.fdopen(fd, "w", encoding="utf-8") as f:
        f.write(css)
    os.replace(tmp_path, theme_path)
finally:
    if os.path.exists(tmp_path):
        os.unlink(tmp_path)
PY

if (( ACTIVATE == 1 )); then
  mkdir -p "$(dirname "$VESKTOP_SETTINGS_PATH")"

  if [[ -f $VESKTOP_SETTINGS_PATH ]]; then
    tmp=$(mktemp "$VESKTOP_SETTINGS_PATH.XXXXXX")
    jq --arg theme "$VESKTOP_THEME_NAME" '
      .enabledThemes = (((.enabledThemes // []) | map(select(. != $theme))) + [$theme])
      | .transparent = false
    ' "$VESKTOP_SETTINGS_PATH" >"$tmp"
    mv "$tmp" "$VESKTOP_SETTINGS_PATH"
  else
    cat >"$VESKTOP_SETTINGS_PATH" <<EOF
{
  "transparent": false,
  "enabledThemes": ["$VESKTOP_THEME_NAME"]
}
EOF
  fi
fi
