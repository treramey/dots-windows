#!/usr/bin/env bash
set -euo pipefail

usage() {
  printf 'Usage: tv-ssh-connect [--in-terminal|--launch] <ssh-host>\n' >&2
}

message() {
  if [[ -n "${TMUX:-}" ]] && command -v tmux >/dev/null 2>&1; then
    if tmux display-message -d 3000 "$*" 2>/dev/null; then
      return 0
    fi
  fi

  printf '%s\n' "$*" >&2
}

resolve_self() {
  local self="${BASH_SOURCE[0]}"

  if [[ "$self" == /* ]]; then
    printf '%s\n' "$self"
    return 0
  fi

  if command -v -- "$self" >/dev/null 2>&1; then
    command -v -- "$self"
    return 0
  fi

  realpath "$self"
}

launch_detached() {
  if command -v setsid >/dev/null 2>&1; then
    setsid -f "$@" >/dev/null 2>&1
    return 0
  fi

  "$@" >/dev/null 2>&1 &
}

mode="auto"

case "${1:-}" in
  --in-terminal)
    mode="connect"
    shift
    ;;
  --launch)
    mode="launch"
    shift
    ;;
esac

if [[ $# -ne 1 || -z "${1:-}" ]]; then
  usage
  exit 1
fi

host="$1"

if [[ ! "$host" =~ ^[A-Za-z0-9_.@-]+$ ]]; then
  message "Refusing unsafe SSH host: $host"
  exit 1
fi

if [[ "$mode" == "auto" ]]; then
  if [[ -n "${TMUX:-}" ]]; then
    mode="launch"
  else
    mode="connect"
  fi
fi

if [[ "$mode" == "launch" ]]; then
  script="$(resolve_self)"
  title="omaterm: $host"

  message "Opening remote Omaterm: $host"

  if command -v ghostty >/dev/null 2>&1; then
    launch_detached ghostty --gtk-single-instance=false "--title=$title" -e "$script" --in-terminal "$host"
  elif command -v xdg-terminal-exec >/dev/null 2>&1; then
    launch_detached xdg-terminal-exec "--title=$title" -- "$script" --in-terminal "$host"
  else
    message "No terminal launcher found"
    exit 1
  fi

  exit 0
fi

transport="${TV_SSH_TRANSPORT:-mosh}"

case "$transport" in
  mosh)
    if command -v mosh >/dev/null 2>&1; then
      exec mosh -- "$host"
    fi

    printf 'mosh not found; falling back to ssh\n' >&2
    exec ssh -- "$host"
    ;;
  ssh)
    exec ssh -- "$host"
    ;;
  *)
    printf 'Unsupported TV_SSH_TRANSPORT: %s\n' "$transport" >&2
    exit 1
    ;;
esac
